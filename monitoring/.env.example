# Copy these values into an untracked environment source before rendering.
# Never commit real receiver URLs, passwords, or metrics tokens.
ALERT_SMTP_SMARTHOST=smtp.example.org:587
ALERT_SMTP_FROM=alerts@example.org
ALERT_SMTP_USERNAME=replace-with-smtp-user
ALERT_SMTP_PASSWORD=replace-with-smtp-password
ALERT_TEAM_EMAIL=engineering@example.org
ALERT_ONCALL_EMAIL=oncall@example.org
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
ALERT_SLACK_CRITICAL_CHANNEL=#alerts-critical
ALERT_SLACK_WARNING_CHANNEL=#alerts
METRICS_TOKEN=replace-with-at-least-32-random-characters
GRAFANA_ADMIN_USER=replace-with-non-default-admin-user
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
