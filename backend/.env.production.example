# Environment Configuration - Production
NODE_ENV=production

# Server Configuration
PORT=3001
HOST=0.0.0.0

# Database Configuration
DATABASE_PATH=/app/data/city-cleanup.db
EVIDENCE_STORAGE_PATH=/app/data/evidence
EVIDENCE_PERCEPTUAL_DISTANCE_THRESHOLD=12
EVIDENCE_SCENE_HIGH_RISK_BELOW=0.30
EVIDENCE_SCENE_MEDIUM_RISK_BELOW=0.48
EVIDENCE_SYNTHETIC_HIGH_RISK_AT=0.60
EVIDENCE_SYNTHETIC_MEDIUM_RISK_AT=0.25
DATABASE_URL=${DATABASE_URL}

# CORS Configuration
CORS_ORIGIN=${CORS_ORIGIN}

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=1000
AUTH_RATE_LIMIT=20
RATE_LIMIT_WINDOW_MS=900000
JSON_BODY_LIMIT_BYTES=1048576
TRUST_PROXY_HOPS=1
USE_CLOUD_STORAGE=false

# JWT Configuration
JWT_ACCESS_SECRET=${JWT_ACCESS_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=city-cleanup-api
JWT_AUDIENCE=city-cleanup-app

# Celo Sepolia rewards
CELO_REWARDS_ENABLED=${CELO_REWARDS_ENABLED}
CELO_REWARD_DRY_RUN=${CELO_REWARD_DRY_RUN}
CELO_RPC_URL=${CELO_RPC_URL}
CELO_CHAIN_ID=11142220
CELO_REWARD_CONTRACT_ADDRESS=${CELO_REWARD_CONTRACT_ADDRESS}
CELO_TREASURY_PRIVATE_KEY=${CELO_TREASURY_PRIVATE_KEY}
CELO_REQUIRED_CONFIRMATIONS=2
CELO_TREASURY_MIN_BALANCE=0.10
CELO_REWARD_POLICY_VERSION=celo-testnet-v1
CELO_BASE_REWARD=0.01
CELO_PER_SUBMISSION_CAP=0.05
CELO_DAILY_ACCOUNT_CAP=0.10
CELO_WEEKLY_ACCOUNT_CAP=0.35
CELO_DAILY_WALLET_CAP=0.10
CELO_WEEKLY_WALLET_CAP=0.35
CELO_MANUAL_APPROVAL_THRESHOLD=0.03
WALLET_VERIFICATION_DOMAIN=${WALLET_VERIFICATION_DOMAIN}
WALLET_VERIFICATION_URI=${WALLET_VERIFICATION_URI}
WALLET_CHALLENGE_TTL_MS=600000

# Redis Configuration
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# External API Keys
MAPS_API_KEY=${MAPS_API_KEY}
WEATHER_API_KEY=${WEATHER_API_KEY}

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Azure Configuration
AZURE_CLIENT_ID=${AZURE_CLIENT_ID}
AZURE_CLIENT_SECRET=${AZURE_CLIENT_SECRET}
AZURE_TENANT_ID=${AZURE_TENANT_ID}
AZURE_KEY_VAULT_URL=${AZURE_KEY_VAULT_URL}

# Email Configuration
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
EMAIL_FROM=${EMAIL_FROM}

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
ENABLE_CACHE=true

# Security
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
METRICS_TOKEN=${METRICS_TOKEN}
SENTRY_ENABLED=true
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=${SENTRY_RELEASE}
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
AUDIT_IP_HASH_SECRET=${AUDIT_IP_HASH_SECRET}
