# Environment Configuration - Development
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=localhost

# Database Configuration
DATABASE_PATH=./data/city-cleanup.db
EVIDENCE_STORAGE_PATH=./data/evidence
EVIDENCE_PERCEPTUAL_DISTANCE_THRESHOLD=12
EVIDENCE_SCENE_HIGH_RISK_BELOW=0.30
EVIDENCE_SCENE_MEDIUM_RISK_BELOW=0.48
EVIDENCE_SYNTHETIC_HIGH_RISK_AT=0.60
EVIDENCE_SYNTHETIC_MEDIUM_RISK_AT=0.25
DATABASE_URL=postgresql://cleanup_user:cleanup_pass@localhost:5432/city_cleanup

# CORS Configuration
CORS_ORIGIN=http://localhost:19006,http://localhost:80

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=100
AUTH_RATE_LIMIT=20
RATE_LIMIT_WINDOW_MS=900000
JSON_BODY_LIMIT_BYTES=1048576
TRUST_PROXY_HOPS=0
USE_CLOUD_STORAGE=false

# JWT Configuration (use different, randomly generated secrets)
JWT_ACCESS_SECRET=your-development-access-token-secret
JWT_REFRESH_SECRET=your-development-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=city-cleanup-api
JWT_AUDIENCE=city-cleanup-app

# Celo Sepolia rewards (dry-run is safe for local development)
CELO_REWARDS_ENABLED=false
CELO_REWARD_DRY_RUN=true
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_CHAIN_ID=11142220
CELO_REWARD_CONTRACT_ADDRESS=
CELO_TREASURY_PRIVATE_KEY=
CELO_REQUIRED_CONFIRMATIONS=2
CELO_TREASURY_MIN_BALANCE=0.10
CELO_REWARD_POLICY_VERSION=celo-testnet-v1
CELO_BASE_REWARD=0.01
CELO_PER_SUBMISSION_CAP=0.05
CELO_DAILY_ACCOUNT_CAP=0.10
CELO_WEEKLY_ACCOUNT_CAP=0.35
CELO_DAILY_WALLET_CAP=0.10
CELO_WEEKLY_WALLET_CAP=0.35
CELO_MANUAL_APPROVAL_THRESHOLD=0.03
CELO_CATEGORY_MULTIPLIERS_BPS={"plastic":10000,"glass":12000,"metal":15000,"paper":8000,"mixed":10000}
WALLET_VERIFICATION_DOMAIN=city-cleanup.local
WALLET_VERIFICATION_URI=http://localhost
WALLET_CHALLENGE_TTL_MS=600000

# Redis Configuration (if using)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# External API Keys
MAPS_API_KEY=your-maps-api-key
WEATHER_API_KEY=your-weather-api-key

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev

# Azure Configuration (Development)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_KEY_VAULT_URL=

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@citycleanup.local

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_NOTIFICATIONS=true
ENABLE_CACHE=false

# Development Tools
DEBUG=app:*
MOCK_DATA=true

# Monitoring & Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
APP_VERSION=1.0.0

# Prometheus
METRICS_ENABLED=true
METRICS_PATH=/api/metrics
METRICS_TOKEN=

# Logging
LOG_ENDPOINT=
LOG_HOST=localhost
LOG_PORT=3100
LOG_PATH=/loki/api/v1/push

# Alerting
SLACK_WEBHOOK_URL=
PAGERDUTY_KEY=
