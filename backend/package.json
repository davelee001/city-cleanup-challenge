{
  "name": "city-cleanup-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --quiet src/server.js",
    "health": "node scripts/health-check.js",
    "db:verify": "node scripts/verify-database.js",
    "db:import-sqlite": "node scripts/migrate-sqlite-to-postgres.js",
    "db:backup": "node scripts/backup-postgres.js",
    "db:restore": "node scripts/restore-postgres.js",
    "db:migrate-passwords": "node scripts/migrate-plaintext-passwords.js",
    "pilot:preflight": "node scripts/celo-pilot-preflight.js",
    "pilot:smoke": "node scripts/pilot-smoke-test.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint . --ext .js,.jsx",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate:gamification": "node scripts/run-gamification-migration.js",
    "test:gamification": "node scripts/test-gamification.js",
    "setup:gamification": "npm run migrate:gamification && npm run test:gamification",
    "migrate:social": "node src/migrations/social-features-system.js",
    "test:social": "node scripts/test-social.js",
    "setup:social": "npm run migrate:social && npm run test:social"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@sentry/node": "^7.100.0",
    "@sentry/profiling-node": "^1.3.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "geolib": "^3.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "multer-s3": "^3.0.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.22.0",
    "piexifjs": "^1.0.6",
    "prom-client": "^15.1.0",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1",
    "viem": "^2.55.8",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "axios": "^1.6.0",
    "colors": "^1.4.0",
    "eslint": "^10.8.0",
    "globals": "^16.4.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnvironment.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 35,
        "functions": 45,
        "lines": 45,
        "statements": 45
      }
    }
  }
}
